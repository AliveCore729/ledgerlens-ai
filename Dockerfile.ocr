# -----------------------------------
# Stage 1: Build the Application
# -----------------------------------
FROM node:20-alpine AS builder

RUN npm install -g pnpm@9.0.0

WORKDIR /app

# Install necessary OS packages for OCR (tesseract)
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-eng tesseract-ocr-data-osd

# Copy configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/database/package.json ./packages/database/
COPY services/ocr/package.json ./services/ocr/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy the rest of the source code
COPY . .

# Generate Prisma Client
RUN cd packages/database && npx prisma generate

# Build the OCR Worker
RUN cd services/ocr && pnpm run build

# -----------------------------------
# Stage 2: Production Image
# -----------------------------------
FROM node:20-alpine AS runner

RUN npm install -g pnpm@9.0.0

# Install necessary OS packages for OCR in production
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-eng tesseract-ocr-data-osd

WORKDIR /app

# Set production environment
ENV NODE_ENV production

# Copy necessary files from builder
COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder /app/services/ocr/package.json ./services/ocr/
COPY --from=builder /app/packages/database/package.json ./packages/database/

# Install ONLY production dependencies
RUN pnpm install --prod --frozen-lockfile

# Copy the built code
COPY --from=builder /app/services/ocr/dist ./services/ocr/dist
COPY --from=builder /app/packages/database ./packages/database

WORKDIR /app/services/ocr

# Start the OCR worker
CMD ["node", "dist/index.js"]
