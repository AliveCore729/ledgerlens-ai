# Dependencies — never copy local node_modules into the image
# (Docker installs them fresh inside the container via pnpm install)
**/node_modules

# Build outputs — the Dockerfile builds these fresh inside the container
**/.next
**/dist
**/build
**/out

# Turbo cache
**/.turbo

# Local env files — secrets should not be in the image
.env
.env.local
.env.production
.env.*.local
env.production.backup

# Git
.git
.gitignore
.github

# Docker files themselves
Dockerfile*
docker-compose*.yml
nginx/

# Dev tools / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem

# Generated Prisma (gets regenerated inside container)
generated/
