# ==========================================
# LedgerLens Production Environment Variables
# ==========================================
# Use this file with `docker compose --env-file .env.production up -d`

# Database Credentials
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=my_secure_database_password_123
POSTGRES_DB=ledgerlens

# RabbitMQ Credentials
RABBITMQ_USER=ledgerlens
RABBITMQ_PASS=my_secure_rabbitmq_password_123

# Application Secrets
JWT_SECRET=my_super_secret_jwt_key_that_should_be_long_and_random

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Integration (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
