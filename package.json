{
  "name": "ledgerlens-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "if [ \"$RENDER\" = \"true\" ]; then cd packages/database && npx prisma generate && npx prisma db push; fi"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0"
  }
}
